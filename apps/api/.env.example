# Copy to apps/api/.env for local development. Placeholders only: never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

# Local docker-compose (infra/docker-compose.yml). Port 55432 avoids Windows reserved ranges.
DATABASE_URL=postgres://saheli:saheli_local_only@localhost:55432/saheli
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# DATA_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars
HASH_PEPPER=replace-with-a-different-random-secret-of-32-chars
DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# console = print codes to the server log (development only). Staging/production refuse it.
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_IP_PER_HOUR=30

# Comma-separated browser origins allowed to call the API (admin dashboard).
CORS_ORIGINS=http://localhost:3001
# Number of trusted reverse-proxy hops in front of the API (0 locally).
TRUST_PROXY_HOPS=0

# Maps and places: `estimate` uses straight-line estimates and a small landmark list (development only).
MAPS_PROVIDER=estimate
GOOGLE_MAPS_API_KEY=
# Driver documents: `local` writes to STORAGE_LOCAL_DIR (development only; S3 not yet implemented).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
TERMS_VERSION=2026-10-draft

# Payments: `sandbox` never moves money and is refused in staging/production.
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret-dev-only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Base URL for trip-share links (the token is appended).
SHARE_LINK_BASE_URL=http://localhost:3000/v1/public/trips/

# Push: `none` records pushes as SKIPPED; `expo` sends via the Expo push service.
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=

# App Links / Universal Links verification files (optional; see docs/MOBILE_RELEASE.md).
ANDROID_APP_LINK_SHA256=
IOS_TEAM_ID=

# App-store review accounts (see docs/MOBILE_RELEASE.md). Leave empty to disable.
# Company-controlled +91 numbers, comma-separated, and a random 6-digit code.
REVIEW_LOGIN_PHONES=
REVIEW_LOGIN_CODE=
