# Copy to apps/api/.env for local development. Placeholders only: never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local docker-compose (infra/docker-compose.yml). Port 55432 avoids Windows reserved ranges.
DATABASE_URL=postgres://saheli:saheli_local_only@localhost:55432/saheli
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars
HASH_PEPPER=replace-with-a-different-random-secret-of-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# console = print codes to the server log (development only). Staging/production refuse it.
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_IP_PER_HOUR=30

# Comma-separated browser origins allowed to call the API (admin dashboard).
CORS_ORIGINS=http://localhost:3001
# Number of trusted reverse-proxy hops in front of the API (0 locally).
TRUST_PROXY_HOPS=0
