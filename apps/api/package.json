{
  "name": "@saheli/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "postdb:generate": "node scripts/unquote-postgis-types.mjs",
    "admin:create": "tsx src/admin/create-staff.ts",
    "test:perf": "vitest run --project perf"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.8",
    "@saheli/domain": "0.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.18.12",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
