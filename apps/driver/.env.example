# Local API (use your computer's LAN IP so a phone or emulator can reach it; 10.0.2.2 for the Android emulator).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Release builds do not read this file: EAS sets APP_VARIANT from eas.json and the rest
# from its "preview" / "production" environments. See docs/MOBILE_RELEASE.md.
# APP_VARIANT=development
# EAS_PROJECT_ID=
# EXPO_OWNER=
